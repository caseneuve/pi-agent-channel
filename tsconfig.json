{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"]
  },
  "include": [
    "bin/**/*.ts",
    "extensions/**/*.ts",
    "relay/**/*.ts",
    "scripts/**/*.ts"
  ]
}
